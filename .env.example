# Default: one shared local Node.js process. Cloud adaptation is opt-in.
SHOP_BACKEND=local
# Never share a PGlite directory across processes.
# Server-side PGlite persistent PostgreSQL directory:
# SHOP_DATA_DIR=C:/ShopHelper/data/postgres
# Server only. Create .env.local from this file; never put a real key in Git.
# Use a dedicated Gemini Developer API project with NO billing account linked.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Set true ONLY after checking that this key's project remains on the free tier.
GEMINI_FREE_TIER_CONFIRMED=false
# Local protective limits, not a claim about Google's project-specific quotas.
GEMINI_MAX_RPM=3
GEMINI_MAX_RPD=20

# Enable daily JSON backups after choosing durable storage. No external service.
SHOP_AUTO_BACKUP=false
# Optional absolute directory on another disk / existing backup location:
# SHOP_BACKUP_DIR=C:/ShopHelper/data/backups

# Optional fixed browser-facing origin (no trailing slash), required behind a reverse proxy:
# SHOP_PUBLIC_ORIGIN=https://your-existing-host.example

# Cloud only: configure on the SERVER after local testing and Free-plan checks.
# Do not add NEXT_PUBLIC_ prefixes. Do not paste keys into chat or Git.
SHOP_CLOUD_FREE_TIER_CONFIRMED=false
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Project legacy JWT secret, only for short-lived revision-only Realtime JWTs.
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=shop-private
# Optional certificate from your own project's Connect / SSL instructions:
# SHOP_DB_CA_FILE=assets/supabase-ca.crt
# For cloud: SHOP_PUBLIC_ORIGIN=https://your-site.netlify.app
