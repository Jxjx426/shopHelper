# Stage 1 uses on-disk server-side PostgreSQL. Optional absolute path:
# SHOP_DATA_DIR=C:/ShopHelper/data/postgres
# Server only. Create .env.local from this file; never put a real key in Git.
# Use a dedicated Gemini Developer API project with NO billing account linked.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Set true ONLY after checking that this key's project remains on the free tier.
GEMINI_FREE_TIER_CONFIRMED=false
# Local protective limits, not a claim about Google's project-specific quotas.
GEMINI_MAX_RPM=3
GEMINI_MAX_RPD=20
